{
  "name": "open-watch-party",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:extension": "pnpm --filter @open-watch-party/extension dev",
    "dev:firefox": "pnpm --filter @open-watch-party/extension dev:firefox",
    "dev:server": "pnpm --filter @open-watch-party/server dev",
    "build": "pnpm --filter @open-watch-party/extension build",
    "build:firefox": "pnpm --filter @open-watch-party/extension build:firefox",
    "build:safari": "pnpm --filter @open-watch-party/extension build:safari",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "pnpm --filter @open-watch-party/shared typecheck && pnpm --filter @open-watch-party/server typecheck && pnpm --filter @open-watch-party/extension check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "release:extension": "release-it --config .release-it.extension.json",
    "release:extension:dry-run": "release-it --config .release-it.extension.json --dry-run",
    "release:server": "release-it --config .release-it.server.json",
    "release:server:dry-run": "release-it --config .release-it.server.json --dry-run",
    "postinstall": "pnpm --filter @open-watch-party/extension exec wxt prepare"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "@release-it/bumper": "^7.0.6",
    "@types/node": "^25.9.3",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.79.0",
    "release-it": "^20.2.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.1.3"
}
