{
  "name": "@open-watch-party/extension",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:safari": "wxt build -b safari",
    "zip": "wxt zip",
    "test": "vitest run",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "release": "cd ../.. && release-it --config .release-it.extension.json"
  },
  "dependencies": {
    "@webext-core/messaging": "^3.0.2",
    "partysocket": "^1.2.0",
    "ts-pattern": "catalog:"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.2",
    "@lucide/svelte": "^1.20.0",
    "@open-watch-party/shared": "workspace:*",
    "@tailwindcss/vite": "latest",
    "@tsconfig/svelte": "^5.0.8",
    "@types/webextension-polyfill": "^0.12.5",
    "@wxt-dev/module-svelte": "^2.0.5",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "shadcn-svelte": "^1.3.0",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.1",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "wxt": "^0.20.26"
  }
}
