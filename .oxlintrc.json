{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "import", "unicorn", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "ignorePatterns": [
    "**/.wxt/**",
    "**/coverage/**",
    "**/dist/**",
    "**/.wrangler/**",
    "**/*.d.ts",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    ".zed/**"
  ],
  "rules": {},
  "overrides": [
    {
      "files": ["apps/server/**/*.ts"],
      "env": {
        "node": true
      }
    },
    {
      "files": ["packages/shared/**/*.ts"],
      "env": {
        "browser": true,
        "node": true
      }
    },
    {
      "files": ["apps/extension/**/*.ts", "apps/extension/**/*.js"],
      "env": {
        "browser": true
      },
      "globals": {
        "browser": "readonly",
        "chrome": "readonly"
      }
    }
  ]
}
